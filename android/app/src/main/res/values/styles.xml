<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The theme shown while Flutter boots, and again while the engine loads a
         model, so the very first thing the learner sees is K100's own dark
         background rather than a white flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#05070F</item>
        <item name="android:navigationBarColor">#05070F</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Applied after the first Flutter frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">#05070F</item>
        <item name="android:navigationBarColor">#05070F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
